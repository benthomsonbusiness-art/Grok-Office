{
  // Same Worker as wrangler.jsonc, but static files are bundled into the script.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grok-office",
  "main": "src/embeddedEntry.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "OFFICE_HUB", "class_name": "OfficeHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OfficeHub"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
