{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grok-office",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OFFICE_HUB",
        "class_name": "OfficeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OfficeHub"]
    }
  ],
  // Pull request builds run `wrangler preview`. Assets and migrations stay at
  // the top level. The Durable Object binding is not inherited, so each
  // preview needs its own copy or the dashboard has no office to read.
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "OFFICE_HUB",
          "class_name": "OfficeHub"
        }
      ]
    }
  }
}
